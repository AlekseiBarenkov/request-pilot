# Скопируйте файл в .env и заполните нужные значения.
# .env не коммитится и не попадает в клиентский бандл.

PORT=3001

# auto: DeepSeek при наличии ключа, иначе демо.
# demo: только подготовленные примеры.
# deepseek: только реальный провайдер, без ключа сервер не запустится.
# fake: тестовый провайдер, запрещён в production.
AI_PROVIDER=auto

# Ключ DeepSeek. Хранится только на сервере.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=2000

# Эти лимиты будут включены на этапе 5.
AI_DAILY_REQUEST_LIMIT=100
RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_AI_REQUESTS=3

TRUST_PROXY=0
